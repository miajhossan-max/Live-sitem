                <div onclick="sendGiftItem('কেক', 20)" class="bg-slate-800 p-3 rounded-2xl text-center cursor-pointer border border-slate-700">
                    <div class="text-xl mb-1">🎂</div>
                    <div class="text-[11px] font-bold">কেক</div>
                    <div class="text-[10px] text-pink-400">20 🪙</div>
                </div>
                <div onclick="sendGiftItem('রোজ বাইক', 5500)" class="bg-slate-800 p-3 rounded-2xl text-center cursor-pointer border border-slate-700">
                    <div class="text-xl mb-1">🏍️</div>
                    <div class="text-[11px] font-bold">বাইক</div>
                    <div class="text-[10px] text-pink-400">5500 🪙</div>
                </div>
                <div onclick="sendGiftItem('জ্যাকেট', 7000)" class="bg-slate-800 p-3 rounded-2xl text-center cursor-pointer border border-slate-700">
                    <div class="text-[19px] mb-1">🧥</div>
                    <div class="text-[11px] font-bold">জ্যাকেট</div>
                    <div class="text-[10px] text-pink-400">7000 🪙</div>
                </div>
                <div onclick="sendGiftItem('লাকি কারেন্ট', 50)" class="bg-slate-800 p-3 rounded-2xl text-center cursor-pointer border border-slate-700">
                    <div class="text-xl mb-1">⚡</div>
                    <div class="text-[11px] font-bold">কারেন্ট</div>
                    <div class="text-[10px] text-pink-400">50 🪙</div>
                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    <script>
        // Tab Navigation Switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            ['hi', 'moments', 'rooms', 'chats', 'profile'].forEach(id => {
                const btn = document.getElementById(`nav-${id}`);
                if (id === tabId) {
                    btn.className = "flex flex-col items-center space-y-1 text-purple-600 font-bold transition";
                } else {
                    btn.className = "flex flex-col items-center space-y-1 text-slate-400 hover:text-purple-600 transition";
                }
            });
        }

        // Room View Overlay
        function enterRoom(roomName, roomId) {
            document.getElementById('room-title-text').innerText = roomName;
            document.getElementById('room-id-text').innerText = roomId;
            document.getElementById('room-view-overlay').classList.remove('hidden');
        }

        function closeRoomView() {
            document.getElementById('room-view-overlay').classList.add('hidden');
        }

        // Seat Click
        function clickSeat(seatNum) {
            showToast(`সিট #${seatNum} এ মাইক রিকোয়েস্ট পাঠানো হয়েছে!`);
        }

        // Room Chat Messaging
        function sendRoomMessage() {
            const input = document.getElementById('room-msg-input');
            if (!input.value.trim()) return;
            const log = document.getElementById('room-chat-log');
            const div = document.createElement('div');
            div.className = "bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-xl text-[11px] text-white inline-block";
            div.innerHTML = `<span class="font-bold text-purple-300">ore ore pain:</span> ${input.value}`;
            log.appendChild(div);
            input.value = "";
            log.scrollTop = log.scrollHeight;
        }

        // Settings Modal
        function openSettingsModal() {
            document.getElementById('settings-modal').classList.remove('hidden');
        }
        function closeSettingsModal() {
            document.getElementById('settings-modal').classList.add('hidden');
        }

        // Room Profile Modal
        function openRoomProfileModal() {
            document.getElementById('room-profile-modal').classList.remove('hidden');
        }
        function closeRoomProfileModal() {
            document.getElementById('room-profile-modal').classList.add('hidden');
        }

        // Gift Modal
        function openGiftModal() {
            document.getElementById('gift-modal').classList.remove('hidden');
        }
        function closeGiftModal() {
            document.getElementById('gift-modal').classList.add('hidden');
        }
        function sendGiftItem(itemName, cost) {
            closeGiftModal();
            showToast(`${itemName} উপহার সফলভাবে পাঠানো হয়েছে! (${cost} কয়েন)`);
        }

        // Toast Notification
        function showToast(message) {
            const toast = document.createElement('div');
            toast.className = "absolute top-16 left-1/2 transform -translate-x-1/2 bg-slate-900 border border-purple-500 text-white text-xs font-semibold px-4 py-2.5 rounded-2xl shadow-2xl z-50 transition-all duration-300";
            toast.innerText = message;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        // Auxiliary Modals
        function openRoomApplyModal() { showToast("নতুন রুম খোলার আবেদন ফরম খোলা হয়েছে"); }
        function openCreatePostModal() { showToast("নতুন মুহূর্ত পোস্ট উইন্ডো"); }
        function openGalleryModal() { showToast("রুম গ্যালারি ও ফটো অ্যালবাম"); }
        function openGameModal() { showToast("রুম লাকি গেম ও জ্যাকপট লোড হচ্ছে"); }
        function openRoomMoreMenu() { showToast("রুম অপশন মেনু"); }
        function likePost(btn) {
            btn.innerHTML = `<i class="fa-solid fa-heart text-pink-500"></i> <span class="text-pink-500 font-bold">127</span>`;
            showToast("পোস্টে লাইক দেওয়া হয়েছে!");
        }
    </script>
</body>
</html>
